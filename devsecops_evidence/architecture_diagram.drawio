<mxfile host="app.diagrams.net" modified="2026-10-14T17:40:00.000Z" agent="DevSecOps Engineering Agent" version="21.0.0" type="device">
  <diagram id="aws_devsecops_arch" name="AWS Cloud Architecture">
    <mxGraphModel dx="1422" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Block -->
        <mxCell id="title" value="IoT-Based Smart Energy Monitoring System - AWS DevSecOps Cloud Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Terraform Automated Provisioning | Hardened Docker Container | Least-Privilege IAM &amp; IMDSv2" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="300" y="55" width="600" height="20" as="geometry" />
        </mxCell>

        <!-- User / Browser Client -->
        <mxCell id="client" value="&lt;b&gt;End User / Browser&lt;/b&gt;&lt;br&gt;Streamlit Web UI&lt;br&gt;&lt;font color=&quot;#2563EB&quot;&gt;http://&amp;lt;EC2_IP&amp;gt;:8501&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=12;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- AWS Cloud Boundary -->
        <mxCell id="aws_cloud" value="&lt;b&gt;AWS Cloud (Region: ap-south-1)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=13;fontColor=#B45309;" vertex="1" parent="1">
          <mxGeometry x="250" y="90" width="900" height="660" as="geometry" />
        </mxCell>

        <!-- Internet Gateway -->
        <mxCell id="igw" value="&lt;b&gt;Internet Gateway (IGW)&lt;/b&gt;&lt;br&gt;Route: 0.0.0.0/0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="280" y="280" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Flow: Client to IGW -->
        <mxCell id="flow_client_igw" value="HTTP (TCP 8501)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;fontSize=11;" edge="1" parent="1" source="client" target="igw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- AWS VPC Boundary -->
        <mxCell id="vpc" value="&lt;b&gt;AWS VPC (10.0.0.0/16)&lt;/b&gt; - dns_hostnames: true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="460" y="130" width="670" height="600" as="geometry" />
        </mxCell>

        <!-- Public Subnet Boundary -->
        <mxCell id="subnet" value="&lt;b&gt;Public Subnet (10.0.1.0/24)&lt;/b&gt; - AZ: ap-south-1a / Dynamic AZ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="480" y="170" width="630" height="540" as="geometry" />
        </mxCell>

        <!-- Security Group Boundary -->
        <mxCell id="sg" value="&lt;b&gt;Security Group (app-sg)&lt;/b&gt;&lt;br&gt;• Ingress: TCP 8501 (Configurable CIDR)&lt;br&gt;• SSH: Port 22 Disabled by default&lt;br&gt;• Egress: All outbound (0.0.0.0/0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=11;fontColor=#065F46;" vertex="1" parent="1">
          <mxGeometry x="500" y="240" width="590" height="450" as="geometry" />
        </mxCell>

        <!-- Flow: IGW to Security Group -->
        <mxCell id="flow_igw_sg" value="Ingress Route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=11;" edge="1" parent="1" source="igw" target="ec2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- EC2 Instance -->
        <mxCell id="ec2" value="&lt;b&gt;Amazon EC2 Instance (t3.small)&lt;/b&gt;&lt;br&gt;• OS: Amazon Linux 2023 (AL2023)&lt;br&gt;• &lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;IMDSv2 Enforced&lt;/b&gt; (http_tokens=required)&lt;/font&gt;&lt;br&gt;• SSM Managed Instance Profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F97316;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="520" y="320" width="550" height="350" as="geometry" />
        </mxCell>

        <!-- Docker Engine inside EC2 -->
        <mxCell id="docker_daemon" value="&lt;b&gt;Docker Engine (systemd managed)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontSize=11;fontColor=#0369A1;" vertex="1" parent="1">
          <mxGeometry x="540" y="390" width="510" height="180" as="geometry" />
        </mxCell>

        <!-- Streamlit Container -->
        <mxCell id="container" value="&lt;b&gt;Hardened Container: smart-energy-monitor:latest&lt;/b&gt;&lt;br&gt;• Base: python:3.12-slim (Debian 13 Trixie)&lt;br&gt;• User: &lt;b&gt;appuser:1001&lt;/b&gt; (/sbin/nologin - Least Privilege)&lt;br&gt;• Port: 8501 (Streamlit Server)&lt;br&gt;• Healthcheck: curl -f http://localhost:8501/_stcore/health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;spacingLeft=10;fontSize=10;fontColor=#1E40AF;" vertex="1" parent="1">
          <mxGeometry x="560" y="430" width="310" height="120" as="geometry" />
        </mxCell>

        <!-- Container Volume Mount Point -->
        <mxCell id="mount" value="&lt;b&gt;Volume Mount&lt;/b&gt;&lt;br&gt;/var/data/energy&lt;br&gt;↓&lt;br&gt;/app/data" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FEF08A;strokeColor=#CA8A04;strokeWidth=1.5;fontSize=10;fontColor=#854D0E;" vertex="1" parent="1">
          <mxGeometry x="910" y="440" width="110" height="100" as="geometry" />
        </mxCell>

        <!-- Flow: Container to Volume -->
        <mxCell id="flow_cont_vol" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#CA8A04;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="container" target="mount">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Encrypted EBS Volume -->
        <mxCell id="ebs" value="&lt;b&gt;Encrypted Root EBS Storage&lt;/b&gt;&lt;br&gt;• Type: gp3, 20 GB&lt;br&gt;• &lt;font color=&quot;#16A34A&quot;&gt;&lt;b&gt;AWS KMS Encrypted&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Stores SQLite energy.db" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="540" y="590" width="510" height="60" as="geometry" />
        </mxCell>

        <!-- IAM & Systems Manager Block -->
        <mxCell id="ssm" value="&lt;b&gt;AWS Systems Manager (SSM)&lt;/b&gt;&lt;br&gt;IAM Role: &lt;i&gt;AmazonSSMManagedInstanceCore&lt;/i&gt;&lt;br&gt;Secure shell access without open SSH Port 22" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=1.5;fontSize=10;fontColor=#581C87;" vertex="1" parent="1">
          <mxGeometry x="880" y="150" width="230" height="65" as="geometry" />
